{
  "name": "youtube-downloader",
  "version": "2.1.0",
  "description": "Electron app that downloads a YouTube playlist as mp3 or mp4",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "repository": "https://github.com/lleellee0/youtube-downloader",
  "keywords": [
    "Electron",
    "youtube",
    "downloader",
    "playlist",
    "mp3",
    "mp4"
  ],
  "author": "lleellee0",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "youtube-dl-exec": "^3.1.9"
  },
  "build": {
    "appId": "com.lleellee0.youtube-downloader",
    "productName": "youtube-downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "!test.js",
      "!README.md"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/youtube-dl-exec/bin/**"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    }
  }
}
